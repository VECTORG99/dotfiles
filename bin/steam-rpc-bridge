#!/usr/bin/env python3
import os
import socket
import struct
import json
import time
import subprocess
import sys
import urllib.request
import re

SOCKET_PATH = os.getenv("DISCORD_IPC", f"/run/user/{os.getuid()}/discord-ipc-0")
POLL_INTERVAL = 5
DETECTABLE_URL = "https://raw.githubusercontent.com/OpenAsar/arrpc/main/src/process/detectable.json"
CACHE_FILE = os.path.expanduser("~/.cache/steam-rpc-detectable.json")

steam_to_discord = {}

def load_detectable_db():
    global steam_to_discord
    data = None
    if os.path.exists(CACHE_FILE) and time.time() - os.path.getmtime(CACHE_FILE) < 86400:
        try:
            with open(CACHE_FILE) as f:
                data = json.load(f)
        except Exception:
            pass
    if not data:
        try:
            with urllib.request.urlopen(DETECTABLE_URL, timeout=10) as r:
                data = json.loads(r.read())
            os.makedirs(os.path.dirname(CACHE_FILE), exist_ok=True)
            with open(CACHE_FILE, "w") as f:
                json.dump(data, f)
        except Exception as e:
            print(f"[bridge] Could not fetch detectable DB: {e}", file=sys.stderr)
            if os.path.exists(CACHE_FILE):
                with open(CACHE_FILE) as f:
                    data = json.load(f)
    if data:
        for entry in data:
            for sku in entry.get("third_party_skus", []):
                if sku.get("distributor") == "steam":
                    steam_to_discord[sku["id"]] = {
                        "id": entry["id"],
                        "name": entry["name"],
                        "aliases": entry.get("aliases", []),
                        "icon_hash": entry.get("icon_hash", ""),
                    }

def get_processes_with_steam_app_id():
    games = {}
    try:
        for entry in os.listdir("/proc"):
            if not entry.isdigit():
                continue
            try:
                with open(f"/proc/{entry}/environ", "rb") as f:
                    env = f.read().replace(b"\x00", b"\n").decode(errors="replace")
                for line in env.split("\n"):
                    if line.startswith("SteamAppId="):
                        app_id = line.split("=", 1)[1].strip()
                        games[app_id] = int(entry)
            except (IOError, OSError, PermissionError):
                continue
    except Exception:
        pass
    return games

def get_game_name_from_steam(app_id):
    try:
        url = f"https://store.steampowered.com/api/appdetails?appids={app_id}"
        with urllib.request.urlopen(url, timeout=5) as r:
            data = json.loads(r.read())
        if data.get(app_id, {}).get("success"):
            return data[app_id]["data"]["name"]
    except Exception:
        pass
    return None

def send_to_discord(sock, payload):
    data = json.dumps(payload).encode()
    header = struct.pack("<II", 1, len(data))
    try:
        sock.send(header + data)
        resp_header = sock.recv(8)
        if resp_header:
            op, length = struct.unpack("<II", resp_header)
            resp_data = b""
            while len(resp_data) < length:
                chunk = sock.recv(length - len(resp_data))
                if not chunk:
                    break
                resp_data += chunk
            return json.loads(resp_data.decode())
    except (socket.timeout, ConnectionError, OSError) as e:
        return {"error": str(e)}
    return None

def set_activity(sock, steam_app_id, game_name, discord_info):
    activity = {
        "pid": os.getpid(),
        "activity": {
            "name": game_name,
            "timestamps": {"start": int(time.time() * 1000)},
        },
    }
    if discord_info:
        activity["activity"]["application_id"] = discord_info["id"]
        activity["activity"]["assets"] = {
            "large_image": discord_info["icon_hash"],
            "large_text": game_name,
        }
    else:
        activity["activity"]["application_id"] = steam_app_id
    result = send_to_discord(
        sock, {"cmd": "SET_ACTIVITY", "args": activity, "nonce": str(int(time.time() * 1000))}
    )
    return result

def clear_activity(sock):
    activity = {"pid": os.getpid(), "activity": None}
    result = send_to_discord(
        sock, {"cmd": "SET_ACTIVITY", "args": activity, "nonce": str(int(time.time() * 1000))}
    )
    return result

def connect():
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(3)
    sock.connect(SOCKET_PATH)
    payload = json.dumps({"v": 1, "client_id": "0"}).encode()
    header = struct.pack("<II", 0, len(payload))
    sock.send(header + payload)
    resp_header = sock.recv(8)
    if not resp_header:
        raise ConnectionError("No handshake response")
    op, length = struct.unpack("<II", resp_header)
    data = b""
    while len(data) < length:
        chunk = sock.recv(length - len(data))
        if not chunk:
            break
        data += chunk
    resp = json.loads(data.decode())
    print(f"[bridge] Connected to Discord IPC as {resp.get('data', {}).get('user', {}).get('username', '?')}")
    return sock

def main():
    print(f"[bridge] Steam RPC bridge starting (PID {os.getpid()})")
    load_detectable_db()
    print(f"[bridge] Loaded {len(steam_to_discord)} Steam games in detectable DB")
    name_cache = {}
    last_ids = set()

    while True:
        try:
            sock = connect()
        except Exception as e:
            print(f"[bridge] Cannot connect to Discord IPC: {e}, retrying in {POLL_INTERVAL}s", file=sys.stderr)
            time.sleep(POLL_INTERVAL)
            continue

        try:
            while True:
                running = get_processes_with_steam_app_id()
                current_ids = set(running.keys())

                if current_ids != last_ids:
                    if current_ids:
                        sid = next(iter(current_ids))
                        discord_info = steam_to_discord.get(sid)
                        name = discord_info["name"] if discord_info else name_cache.get(sid)
                        if not name:
                            name = get_game_name_from_steam(sid)
                            if name:
                                name_cache[sid] = name
                        if not name:
                            name = sid
                        print(f"[bridge] Steam game detected (AppID {sid}): {name}")
                        if discord_info:
                            print(f"[bridge]   Discord App ID: {discord_info['id']}")
                        result = set_activity(sock, sid, name, discord_info)
                        if result and "error" in result:
                            print(f"[bridge] Error: {result['error']}", file=sys.stderr)
                            break
                    else:
                        if last_ids:
                            print("[bridge] No Steam games running, clearing activity")
                            clear_activity(sock)
                    last_ids = current_ids
                time.sleep(POLL_INTERVAL)
        except (ConnectionError, BrokenPipeError, OSError) as e:
            print(f"[bridge] Connection lost: {e}, reconnecting...", file=sys.stderr)
            last_ids = set()
            time.sleep(POLL_INTERVAL)

if __name__ == "__main__":
    main()
